# Copy to .env and fill in your key. Never commit .env.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Model IDs on Token Factory. Confirm with:  python -m exhibit_a models
EXHIBIT_NANO_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
EXHIBIT_SUPER_MODEL=nvidia/nemotron-3-super-120b-a12b
EXHIBIT_ULTRA_MODEL=nvidia/Nemotron-3-Ultra-550B-A55B

# Sandbox: auto (Docker if available, else local subprocess), docker, or local
EXHIBIT_SANDBOX=auto
